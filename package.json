{
  "name": "SessionLess",
  "version": "1.0.0",
  "description": "SessionLess is an Open Source SessionBoard alternative for speakers featuring live dashboard, speaker portals, declarative form creation, speaker tasks and attachments.",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "bun cross-env NEXT_PUBLIC_CONVEX_URL=$VITE_CONVEX_URL next build",
    "start": "next start",
    "log": "bun run scripts/build_log.ts",
    "upload": "pnpm static-hosting upload --build --dist ./out",
    "deploy": "pnpm static-hosting deploy --skip-build --dist ./out",
    "grammar": "pnpm peggy --format es --output dsl/generated/grammar.js dsl/grammar.peggy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.20.0",
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@convex-dev/static-hosting": "^0.2.1",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@tanstack/markdown": "^0.0.13",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.5",
    "convex": "^1.43.0",
    "cross-env": "^10.1.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.38.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "peggy": "^5.1.0",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "^4.19.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/typescript6": "^6.0.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^4",
    "typescript": "7.0.2"
  }
}
